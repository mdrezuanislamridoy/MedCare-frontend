# ==============================================================================
# MedCare Healthcare Platform - Frontend Environment Variables (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core API & App URLs
# ------------------------------------------------------------------------------
# In Local Development: Point to your local NestJS API Gateway (e.g., http://localhost:5000)
# In Production (Vercel): Point to your live Render backend (e.g., https://medcare-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public Frontend Domain (used for OAuth redirects, canonical links, SEO)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Google OAuth (Sign in with Google)
# ------------------------------------------------------------------------------
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web Application)
# Authorized JavaScript Origins: http://localhost:3000, https://medcare-frontend-delta.vercel.app
# Authorized Redirect URIs: http://localhost:3000/auth/callback, https://medcare-frontend-delta.vercel.app/auth/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. Telehealth & Video Consultation (Agora RTC)
# ------------------------------------------------------------------------------
# Obtained from Agora Developer Console (https://console.agora.io/)
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id_here

# ------------------------------------------------------------------------------
# 4. Payment Gateway (Stripe)
# ------------------------------------------------------------------------------
# Obtained from Stripe Dashboard -> Developers -> API Keys -> Publishable key (pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
