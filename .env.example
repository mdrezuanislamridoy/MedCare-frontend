# ==============================================================================
# MedCare Healthcare Platform - Frontend Environment Variables
# ==============================================================================

# Backend API Gateway Base URL
# - In Local Development: Point to your local NestJS API Gateway (e.g. http://localhost:5000 or http://localhost:3000)
# - In Production (Vercel): Point to your live Render backend URL (e.g. https://medcare-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: Public App URL for SEO & Canonical Links
NEXT_PUBLIC_APP_URL=https://medcare-frontend-delta.vercel.app
